{{- $alternate := get . "alternateGit" | default dict -}}
{{- if get $alternate "enabled" -}}
{{- if not (and (get $alternate "directory") (get $alternate "sshKey")) }}{{ fail "alternateGit: directory と sshKey が必要" }}{{ end -}}
[user]
	name = {{ get $alternate "name" | quote }}
	email = {{ get $alternate "email" | quote }}
[core]
	sshCommand = {{ printf "ssh -i %s -o IdentitiesOnly=yes" (get $alternate "sshKey" | replace "\\" "/" | shellQuote) | quote }}
{{ end -}}
