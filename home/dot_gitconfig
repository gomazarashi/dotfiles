[user]
	name = gomazarashi
	email = gomazarashi0426@gmail.com
[init]
	defaultBranch = main
[core]
	safecrlf = warn
	autocrlf = input
	# Windows only: bypass MAX_PATH (260 chars) via \\?\ prefix. No-op on Linux.
	longpaths = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
