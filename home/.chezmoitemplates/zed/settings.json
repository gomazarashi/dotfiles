// zed/settings.json
{
    "soft_wrap": "editor_width",
    "cli_default_open_behavior": "existing_window",
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": []
    },
    "git_panel": {
        "dock": "left"
    },
    "file_types": {
        "Markdown": [
            "*.rmd"
        ]
    },
    "ensure_final_newline_on_save": true,
    "base_keymap": "VSCode",

    // エディタ本文
    "buffer_font_family": ".ZedMono",
    "buffer_font_fallbacks": [
        "Noto Sans Mono CJK JP",
        "Noto Sans CJK JP"
    ],

    // Markdownプレビュー
    "markdown_preview_font_family": "Noto Sans CJK JP",
    "markdown_preview_code_font_family": "Noto Sans Mono CJK JP",

    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Gruvbox Dark Hard"
    },
    "lsp": {
        "tinymist": {
            "initialization_options": {
                "preview": {
                    "background": {
                        "enabled": true
                    }
                }
            }
        }
    }
}
